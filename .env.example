# ─── Chauka Restaurant System — Environment Config ────────────────────────
# Copy this file to .env and fill in your values.
# The restaurant's license key and server URL are required.
# All other variables are optional — defaults work out of the box.

# ─── Licensing (required for production) ──────────────────────────────────
LICENSE_KEY=CHK-XXXX-XXXX-XXXX-XXXX
LICENSE_SERVER_URL=https://licenses.yourdomain.com
LICENSE_GRACE_DAYS=3
LICENSE_CHECK_INTERVAL_HOURS=1

# ─── Restaurant Settings ──────────────────────────────────────────────────
PORT=3000
WHATSAPP_NUMBER=919876543210

# ─── Manager Panel (optional PIN protection) ──────────────────────────────
# When set, the manager panel asks for this PIN before allowing
# menu edits or loyalty rule changes. Leave empty for open access.
MANAGER_PIN=2468
